# ============================================================
# PAYMIND Enterprise — .gitignore
# ============================================================

# --- Environment variables (NEVER commit these) ---
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!.env.example


# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# --- Build outputs ---
dist/
build/
.next/
out/
*.zip

# --- Vite ---
*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
*.egg
.eggs/
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
logs/
*.log

# --- Testing ---
coverage/
.nyc_output/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Temporary files ---
tmp/
temp/
*.tmp
*.bak
*.backup

# Environment files - keep API keys private
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
