# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# PostgreSQL Configuration
# Option A: Neon PostgreSQL Connection String (Recommended)
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Local PostgreSQL (or discrete variables)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=paymind_db
# DB_USER=postgres
# DB_PASSWORD=your_db_password
# DB_SSL=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CSRF
CSRF_SECRET=your_csrf_secret_min_32_chars

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000
AI_SERVICE_API_KEY=paymind-internal-ai-key-change-in-prod

# PayPal Sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
