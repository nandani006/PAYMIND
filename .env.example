# ============================================================
# PAYMIND Enterprise — Root Environment Reference
# Copy relevant sections into each service's .env file
# NEVER commit .env files to version control
# ============================================================

# --- PostgreSQL ---
# Option A: Neon PostgreSQL (Recommended)
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Option B: Local PostgreSQL (or discrete variables)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=paymind_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_db_password

# --- Backend (Node.js) ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1h
CSRF_SECRET=your_csrf_secret_at_least_32_characters_long
AI_SERVICE_API_KEY=paymind-internal-ai-key-change-in-prod

# --- AI Service (Python) ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000

# --- Gemini API ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-1.5-flash

# --- PayPal Sandbox ---
# Get from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

